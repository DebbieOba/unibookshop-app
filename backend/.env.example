NODE_ENV=development
PORT=3000

# Supabase — Transaction pooler connection string (port 6543, pgbouncer). Used for runtime queries.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Supabase — Direct connection string (port 5432). Used only for `prisma migrate`.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Local Redis (docker-compose.dev.yml) or a hosted free tier, e.g. Upstash —
# note Upstash's ioredis connection string uses "rediss://" (TLS).
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
# The "Secret Hash" you configure in the Flutterwave dashboard's webhook
# settings — NOT the API secret key above. Used to verify incoming webhooks.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""

FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

RESEND_API_KEY=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

SIS_BASE_URL=""
SIS_API_KEY=""
